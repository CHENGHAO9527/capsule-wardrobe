# ══════════════════════════════════════════════════════════
#  这个仓库里**只放源码**。清单沿用 `scripts/make_source_zip.py` 里那份
#  （那份自带密钥扫描，已经被验证过）。
#  ⚠️ 加东西进来之前先问一句：它会不会暴露我自己的钥匙 / 照片 / 口令？
#  ⚠️ git 的忽略规则**不支持行尾注释** —— `llm.json  # 注释` 会被当成一个
#     含空格的模式，于是**根本不匹配**，密钥照样进仓库。注释必须独占一行。
# ══════════════════════════════════════════════════════════

# ── 密钥与口令（绝对不能进仓库）──
# 模型 Key（明文）
llm.json
# 进门口令
gate.json

# ── 私人数据：照片 / 数据库 / 备份 / 应用状态 ──
data/
backups/

# ── 项目记忆：含个人习惯、真实衣橱件数等，是"我的笔记"不是"产品源码" ──
.workbuddy/

# ── 打包产物与安装包：体积大，且 dist 里本身就含上面那些 ──
dist/
tools/

# ── 会暴露线上地址的图（二维码编的是我自己的域名 / 内网地址）──
docs/phone-qr-cloud.png
docs/phone-qr-lan.png

# ── 口播稿（视频文案，不发到仓库）──
docs/口播稿-*.md

# ── 运行时产物 / 缓存 ──
__pycache__/
*.pyc
.venv/
venv/
node_modules/
*.log
*.out.txt
serve.out*
*.bak-*
*.genie

# ── 编辑器 / 系统 ──
.vscode/
.idea/
.DS_Store
Thumbs.db
